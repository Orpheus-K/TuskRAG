{
  "name": "tuskrag",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": "10.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @tuskrag/web dev",
    "build:web": "pnpm --filter @tuskrag/web build",
    "build": "node scripts/build.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.tools.json && pnpm -r --if-present typecheck",
    "test:web": "vitest run",
    "test:e2e": "playwright test",
    "check": "node scripts/check.mjs",
    "generate:client": "openapi-typescript contracts/openapi.json -o packages/api-client/src/schema.ts",
    "generate:parser-schema": "node scripts/sync-parser-schema.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
