[Unit]
Description=TuskRAG knowledge base and question answering
After=network.target

[Service]
Type=simple
User=tuskrag
Group=tuskrag
EnvironmentFile=/etc/tuskrag/tuskrag.env
WorkingDirectory=/opt/tuskrag
ExecStart=/opt/tuskrag/deploy/linux/start.sh
Delegate=cpu memory pids
StateDirectory=tuskrag
RuntimeDirectory=tuskrag
RuntimeDirectoryMode=0700
UMask=0077
KillMode=control-group
TimeoutStopSec=45
Restart=on-failure
RestartSec=5
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
