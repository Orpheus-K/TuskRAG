# Install as /etc/tuskrag/tuskrag.env, owned by root with mode 0600.
# systemd EnvironmentFile syntax: no export, variable expansion or shell code.
TUSKRAG_ROLE=all
TUSKRAG_LISTEN=127.0.0.1:8080
TUSKRAG_DATABASE_URL=postgres://tuskrag_app:REPLACE@127.0.0.1:5432/tuskrag?sslmode=disable
TUSKRAG_WORKER_TENANTS=1
TUSKRAG_STORAGE_DIR=/var/lib/tuskrag/files
TUSKRAG_MASTER_KEY_FILE=/etc/tuskrag/master-key
TUSKRAG_PARSER_RUNTIME_DIR=/opt/tuskrag/parser
TUSKRAG_PARSER=/opt/tuskrag/parser/tuskrag-parse
TUSKRAG_BUBBLEWRAP=/usr/bin/bwrap
TUSKRAG_PARSER_TEMP_DIR=/run/tuskrag
TMPDIR=/run/tuskrag
GOMEMLIMIT=384MiB
# Cookies remain Secure. Put an HTTPS reverse proxy before this loopback port.
