POSTGRES_DB=tuskrag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-postgres-password
TUSKRAG_APP_PASSWORD=replace-with-strong-app-password
TUSKRAG_MIGRATOR_PASSWORD=replace-with-strong-migrator-password
TUSKRAG_WORKER_TENANTS=1
TUSKRAG_MASTER_KEY_HOST_PATH=./secrets/master.key
TUSKRAG_METRICS_TOKEN=replace-with-metrics-bearer-token
TUSKRAG_LEXICAL_DRIVER=auto
TUSKRAG_PORT=8080
